# ═══════════════════════════════════════════════════════════════════════════
# Roshd Professional — environment template
# Copy to `.env` locally or set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real `.env` (secrets).
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase (required for server auth + dashboard API) ───────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional — used only for startup log / tooling (not required by server.js)
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# ─── Dashboard API writes (optional lockdown) ──────────────────────────────
# Default: PUT /api/filters and PUT /api/roshd/config work without a client token
# (simple admin UX). Anyone who can call your API URL can write — protect the deployment URL.
#
# To require Bearer auth again, set:
#   ROSHD_REQUIRE_DASHBOARD_WRITE_AUTH=true
# and set one of:
#   ROSHD_DASHBOARD_ADMIN_TOKEN=<long random secret>
#   ROSHD_FILTERS_ADMIN_TOKEN=<same or alternate; optional>
# Client must then send: Authorization: Bearer <that secret>
#
# When auth is required, you may also allow loopback without Bearer:
#   ROSHD_ALLOW_LOCALHOST_UNAUTH_CONFIG_WRITE=true
#
# ROSHD_REQUIRE_DASHBOARD_WRITE_AUTH=false
# ROSHD_DASHBOARD_ADMIN_TOKEN=
# ROSHD_FILTERS_ADMIN_TOKEN=
# ROSHD_ALLOW_LOCALHOST_UNAUTH_CONFIG_WRITE=false

# ─── HTTP (local `node server.js` only) ───────────────────────────────────
# PORT=5000

# ─── Set automatically on Vercel (do not paste in .env for production deploy) ─
# VERCEL=1
# NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════
# Not used by server.js — keep for Supabase CLI / migrations / direct Postgres
# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# DATABASE_PASSWORD=
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
