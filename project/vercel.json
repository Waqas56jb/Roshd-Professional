{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/customer.html" },
    { "source": "/dashboard", "destination": "/customer.html" },
    { "source": "/dashboard/", "destination": "/customer.html" },
    { "source": "/admin", "destination": "/admin/admin.html" },
    { "source": "/admin/", "destination": "/admin/admin.html" },
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
